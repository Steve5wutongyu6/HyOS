# 文件上下文（供 setfiles/restorecon 与镜像构建标注）
# 类型分离：可执行 / 配置 / 机密 各自独立标签（机密不得与可执行同类型）
/apps(/.*)?               gen_context(system_u:object_r:hyos_app_exec_t,s0)
/run/apps/[^/]+\.(bin|so)  gen_context(system_u:object_r:hyos_app_exec_t,s0)
/run/apps(/.*)?           gen_context(system_u:object_r:hyos_app_conf_t,s0)
/run/apps/tls(/.*)?       gen_context(system_u:object_r:hyos_secret_t,s0)
/run/configs(/.*)?        gen_context(system_u:object_r:hyos_app_conf_t,s0)
/run/hyos-tmp(/.*)?       gen_context(system_u:object_r:hyos_tmp_t,s0)
