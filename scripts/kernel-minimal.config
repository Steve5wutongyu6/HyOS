# HyOS 内核最小化白名单（基座 allnoconfig）
# 目标平台：x86_64 BIOS/KVM 虚机（QEMU 测试 e1000+IDE；生产 KVM virtio）
# 应用层：hysteria2(UDP/443) + 端口跳跃 DNAT(iptables-restore nat)
# 销毁/推进：raw 块设备写(sda/vda/hda) + ACPI S5 断电
# 原则：不编入 HID/USB/无线/蓝牙/声卡/DRM/文件系统(除内存态)/IPv6/模块

# ---- EXPERT：不开的话 VT/PPS 等符号无提示，default y 静默生效（touchscreen/pps 残余根因）
CONFIG_EXPERT=y

# ---- 核心用户态运行所需（allnoconfig 会关掉 EXPERT 默认项，必须显式开）----
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# ---- RTC：TLS 证书校验需要真实时间（CMOS 硬件时钟注入系统时钟）----
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_CMOS=y

CONFIG_TTY=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_BASE_FULL=y
CONFIG_SHMEM=y

# ---- 显式关闭的大块组件 ----
# CONFIG_MODULES is not set
# CONFIG_IPV6 is not set
# CONFIG_USB is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_PPS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_WLAN is not set
# CONFIG_PTP_1588_CLOCK is not set


# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_AUDIT=y
CONFIG_SECURITY_NETWORK=y
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_SWAP is not set
# CONFIG_SYSVIPC is not set
# CONFIG_IO_URING is not set
# CONFIG_SECCOMP is not set
# CONFIG_KALLSYMS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_COREDUMP is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_CGROUPS is not set
# CONFIG_EFI is not set
# CONFIG_MICROCODE is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_HID is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_THERMAL is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_MMC is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PWM is not set
# CONFIG_CRC_ITU_T is not set
# CONFIG_FUSE_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_AUTOFS_FS is not set

# ---- 平台（仅 x86_64/x64：纯 64 位指令集，禁用全部 32 位兼容）----
CONFIG_64BIT=y
# CONFIG_X86_32 is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_COMPAT is not set
# CONFIG_X86_X32_ABI is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_X86_MPPARSE=y
CONFIG_RELOCATABLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_X86_VSYSCALL_EMULATION=y
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y

# ---- 控制台 ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 块设备（测试 QEMU IDE / 生产 KVM virtio+sata）----
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_GZIP=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# ---- 网络（IPv4 + 网卡）----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_SYN_COOKIES=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y

# ---- virtio（生产 KVM）----
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y


# ---- netfilter：仅端口跳跃所需的 IPv4 DNAT ----
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_DNAT=y
# DNAT 目标由 IP_NF_NAT 自动 select 的 NETFILTER_XT_NAT 提供（6.14 起 XT_TARGET_DNAT 已并入）

# ---- SELinux 强制访问控制 ----
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="selinux"

# ---- 构建卫生 ----
# CONFIG_WERROR is not set
